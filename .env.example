# Copy to .env and use your existing Supabase project settings.
# SUPABASE_KEY must be the publishable (or legacy anon) key.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
# Optional server-only service_role credential for account deletion.
# SUPABASE_ACCOUNT_DELETION_KEY=
PORT=3000
# For an HTTPS deployment, set the exact public origin without a trailing slash.
# APP_ORIGIN=https://gather-is-401-product.vercel.app
# NODE_ENV=production

# Required server-only key for password recovery; generate with: openssl rand -hex 32
# AUTH_RECOVERY_SECRET=
# Set APP_ORIGIN for recovery emails (also locally, e.g. http://localhost:3000).
# Never put AUTH_RECOVERY_SECRET in browser JavaScript or commit its real value.
