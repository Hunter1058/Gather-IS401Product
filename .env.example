# Copy to .env and use your existing Supabase project settings.
# Only the publishable (or legacy anon) key belongs here, never a service-role key.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
PORT=3000
# For an HTTPS deployment, set the exact public origin without a trailing slash.
# APP_ORIGIN=https://gather-is-401-product.vercel.app
# NODE_ENV=production
